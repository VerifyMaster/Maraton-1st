import {test, expect} from "@Playwright/test"

test("Assertio-Assignment", async({page})=>{
    await page.goto(" https://leafground.com/input.xhtml.");
    const Disable =  await page.locator('input[placeholder="Disabled"]');
    expect(Disable).toBeDisabled();

    const Enable = await page.locator('//input[@id="j_idt88:name"]');
    expect(Enable).toBeEnabled();
    await Enable.fill("Gaurav Bhardwaj");

    await expect.soft(Disable).toBeDisabled();
    
  const clearTextBox= page.locator('//input[@id="j_idt88:j_idt95"]');

   await clearTextBox.fill("");
   await clearTextBox.fill("Playwright Learning",{timeout: 3000});

});
